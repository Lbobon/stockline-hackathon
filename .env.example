# Copy to .env and fill in. Real values are shared in person, never committed.
ANTHROPIC_API_KEY=

# Twilio: the number that places the calls (E.164, e.g. +33...)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ElevenLabs conversational agent (input and output audio set to ulaw_8000)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Public https address of this server, e.g. from `ngrok http 8080`. Twilio streams the call audio here.
PUBLIC_URL=
PORT=8080
